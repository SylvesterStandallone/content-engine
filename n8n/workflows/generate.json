{
  "name": "generate",
  "nodes": [
    {
      "id": "scheduleTrigger",
      "name": "Schedule Trigger (disabled by default)",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [0, -140],
      "disabled": true,
      "parameters": {
        "rule": { "interval": [{ "field": "minutes", "minutesInterval": 5 }] }
      }
    },
    {
      "id": "webhookTrigger",
      "name": "Webhook - generate-next",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [0, 60],
      "parameters": {
        "path": "generate-next",
        "httpMethod": "POST",
        "authentication": "headerAuth",
        "responseMode": "responseNode"
      },
      "credentials": {
        "httpHeaderAuth": { "id": "RvDB3LJS7LrMwKXs", "name": "Pipeline Shared Token" }
      }
    },
    {
      "id": "readPendingRow",
      "name": "Read Pending Row",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [520, -40],
      "parameters": {
        "resource": "sheet",
        "operation": "read",
        "authentication": "oAuth2",
        "documentId": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "Content Pipeline Queue" },
        "sheetName": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "Sheet1" },
        "filtersUI": {
          "values": [{ "lookupColumn": "status", "lookupValue": "pending" }]
        },
        "options": { "returnAllMatches": "returnFirstMatch" }
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" }
      }
    },
    {
      "id": "hasPendingRow",
      "name": "Has Pending Row?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [740, -40],
      "parameters": {
        "conditions": {
          "combinator": "and",
          "conditions": [
            {
              "id": "c1",
              "leftValue": "={{ $json.row_id }}",
              "rightValue": "",
              "operator": { "type": "string", "operation": "notEquals" }
            }
          ],
          "options": { "caseSensitive": true, "leftValue": "", "typeValidation": "strict", "version": 2 }
        }
      }
    },
    {
      "id": "claimRow",
      "name": "Claim Row (Sheet -> generating)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [960, -140],
      "parameters": {
        "resource": "sheet",
        "operation": "update",
        "authentication": "oAuth2",
        "documentId": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "Content Pipeline Queue" },
        "sheetName": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["row_id"],
          "value": {
            "row_id": "={{ $json.row_id }}",
            "status": "generating"
          },
          "schema": [
            { "id": "row_id", "displayName": "row_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "topic", "displayName": "topic", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" }
      }
    },
    {
      "id": "upsertItem",
      "name": "Upsert Item",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1180, -140],
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO items (sheet_row_id, topic, status) VALUES ($1, $2, 'generating') ON CONFLICT (sheet_row_id) DO UPDATE SET topic = EXCLUDED.topic, status = 'generating', updated_at = now() RETURNING id",
        "options": {
          "queryReplacement": "={{ [ $('Read Pending Row').item.json.row_id, $('Read Pending Row').item.json.topic ] }}"
        }
      },
      "credentials": {
        "postgres": { "id": "MrqOoeDDMzoi2eHj", "name": "Postgres - content_engine" }
      }
    },
    {
      "id": "generateVariant",
      "name": "Generate Variant",
      "type": "n8n-nodes-base.executeWorkflow",
      "typeVersion": 1.3,
      "position": [1400, -140],
      "parameters": {
        "mode": "once",
        "source": "database",
        "workflowId": { "__rl": true, "mode": "id", "value": "Htj6z2JKACbMHdKD" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "item_id": "={{ $json.id }}",
            "topic": "={{ $('Read Pending Row').item.json.topic }}"
          },
          "schema": [
            { "id": "item_id", "displayName": "item_id", "required": false, "defaultMatch": false, "display": true, "type": "number", "canBeUsedToMatch": true },
            { "id": "topic", "displayName": "topic", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": { "waitForSubWorkflow": true }
      }
    },
    {
      "id": "markAwaitingReviewDb",
      "name": "Mark Awaiting Review (DB)",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.6,
      "position": [1620, -140],
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE items SET status = 'awaiting_review', updated_at = now() WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [ $json.item_id ] }}"
        }
      },
      "credentials": {
        "postgres": { "id": "MrqOoeDDMzoi2eHj", "name": "Postgres - content_engine" }
      }
    },
    {
      "id": "markAwaitingReviewSheet",
      "name": "Mark Awaiting Review (Sheet)",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.7,
      "position": [1840, -140],
      "parameters": {
        "resource": "sheet",
        "operation": "update",
        "authentication": "oAuth2",
        "documentId": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "Content Pipeline Queue" },
        "sheetName": { "__rl": true, "mode": "list", "value": "", "cachedResultName": "Sheet1" },
        "columns": {
          "mappingMode": "defineBelow",
          "matchingColumns": ["row_id"],
          "value": {
            "row_id": "={{ $('Read Pending Row').item.json.row_id }}",
            "status": "awaiting_review"
          },
          "schema": [
            { "id": "row_id", "displayName": "row_id", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": true },
            { "id": "topic", "displayName": "topic", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false },
            { "id": "status", "displayName": "status", "required": false, "defaultMatch": false, "display": true, "type": "string", "canBeUsedToMatch": false }
          ]
        },
        "options": {}
      },
      "credentials": {
        "googleSheetsOAuth2Api": { "id": "REPLACE_ME", "name": "Google Sheets account" }
      }
    },
    {
      "id": "respondOk",
      "name": "Respond - OK",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [2060, -140],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'ok', item_id: $('Generate Variant').item.json.item_id, variant_id: $('Generate Variant').item.json.variant_id } }}"
      }
    },
    {
      "id": "respondNoPending",
      "name": "Respond - No Pending Items",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [960, 60],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { status: 'no_pending_items' } }}",
        "options": { "responseCode": 200 }
      }
    }
  ],
  "connections": {
    "Schedule Trigger (disabled by default)": {
      "main": [[{ "node": "Read Pending Row", "type": "main", "index": 0 }]]
    },
    "Webhook - generate-next": {
      "main": [[{ "node": "Read Pending Row", "type": "main", "index": 0 }]]
    },
    "Read Pending Row": {
      "main": [[{ "node": "Has Pending Row?", "type": "main", "index": 0 }]]
    },
    "Has Pending Row?": {
      "main": [
        [{ "node": "Claim Row (Sheet -> generating)", "type": "main", "index": 0 }],
        [{ "node": "Respond - No Pending Items", "type": "main", "index": 0 }]
      ]
    },
    "Claim Row (Sheet -> generating)": {
      "main": [[{ "node": "Upsert Item", "type": "main", "index": 0 }]]
    },
    "Upsert Item": {
      "main": [[{ "node": "Generate Variant", "type": "main", "index": 0 }]]
    },
    "Generate Variant": {
      "main": [[{ "node": "Mark Awaiting Review (DB)", "type": "main", "index": 0 }]]
    },
    "Mark Awaiting Review (DB)": {
      "main": [[{ "node": "Mark Awaiting Review (Sheet)", "type": "main", "index": 0 }]]
    },
    "Mark Awaiting Review (Sheet)": {
      "main": [[{ "node": "Respond - OK", "type": "main", "index": 0 }]]
    }
  },
  "settings": { "executionOrder": "v1" }
}
