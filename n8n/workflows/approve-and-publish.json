    {
      "id": "computeRollup",
      "name": "Compute Rollup Status",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [2280, -70],
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "const items = $('Normalize - TikTok').all().concat($('Normalize - X').all(), $('Normalize - Facebook').all(), $('Normalize - Instagram').all());\nconst successCount = items.filter(i => i.json.pub_status === 'success').length;\nlet rollup;\nif (successCount === items.length) rollup = 'published';\nelse if (successCount === 0) rollup = 'failed';\nelse rollup = 'partial';\nreturn [{ json: { rollup_status: rollup, success_count: successCount, total: items.length } }];"
      }
    },
