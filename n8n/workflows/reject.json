      "typeVersion": 2.6,
      "position": [920, -100],
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id, topic FROM items WHERE id = $1",
        "options": {
          "queryReplacement": "={{ [ $('Reject Variant (guarded)').item.json.item_id ] }}"
        }
