      "typeVersion": 1.3,
      "position": [1140, -100],
      "parameters": {
        "mode": "once",
        "source": "database",
        "workflowId": { "__rl": true, "mode": "id", "value": "Htj6z2JKACbMHdKD" },
        "workflowInputs": {
          "mappingMode": "defineBelow",
          "value": {
            "item_id": "={{ $json.id }}",
            "topic": "={{ $json.topic }}"
